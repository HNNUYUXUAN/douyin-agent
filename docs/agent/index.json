  "command_entry": "PYTHON SKILL/scripts/da.py --workspace WORKSPACE COMMAND",
  "read_only_commands": [
    "doctor",
    "status",
    "onboard --check"
  ],
  "local_record_command": "onboard --record FILE",
  "task_flow": [
    "cleanup --expired",
    "adopt",
    "integrity",
    "preview",
    "run",
    "finalize",
    "validate"
  ],
  "host_operations": [
    "browser_connection",
    "douyin_search",
    "acquisition",
    "usage_communication",
    "original_frame_review"
  ],
  "local_context_files": [
    "workspace.json",
    "onboarding.json",
    "agent-context.json"
  ],
  "constraints": [
    "Do not expose credentials",
    "Do not infer cloud readiness from local checks",
    "Preview before paid calls",
    "Preserve unresolved request reservations",
    "Delete only proven task-owned media",
    "No universal-download guarantee"
  ],
  "helper_commands": [
    {
      "id": "unpack_images",
      "kind": "standalone_helper_not_da_subcommand",
      "script_path": "../../scripts/unpack_images.py",
      "command_entry": "PYTHON SKILL/scripts/unpack_images.py --archive ABS_ZIP --workspace ABS_WORKSPACE --output NEW_ABS_DIR --expected-images N",
      "guide_id": "acquisition",
      "conditions": [
        "Use only an acquired image ZIP and a new short ASCII workspace subdirectory",
        "Natural filename order requires host verification against the original work",
        "Preserve user-imported archives; register only proven task-owned copies"
      ]
    }
  ],
  "installation_entrypoints": {
    "powershell": "../../install.ps1",
    "git_bash": "../../install.sh"
  },
  "environment_entrypoints": {
    "powershell": "../../setup.ps1",
    "git_bash": "../../setup.sh"
  },
  "terminal_support": [
    "Windows Git Bash",
    "PowerShell 7",
    "Windows PowerShell 5.1"
  ],
  "zero_start": {
    "zh-CN": "../../references/bootstrap/zh-CN/first-run.md",
    "en": "../../references/bootstrap/en/first-run.md"
  },
  "knowledge": {
    "bundle": "../../wiki/index.md",
    "script": "../../scripts/knowledge.py",
    "guide": {
      "zh-CN": "../../references/bootstrap/zh-CN/knowledge.md",
      "en": "../../references/bootstrap/en/knowledge.md"
    },
    "format": "OKF 0.2",
    "private_directory": "WORKSPACE/knowledge-private",
    "read_only": [
      "search",
      "validate"
    ],
    "writes": [
      "init",
      "record",
      "reindex"
    ]
  },
  "workbuddy": {
    "install_flag": "-TargetHost workbuddy / --host workbuddy",
    "default_skill_dir": "USER_HOME/.workbuddy/skills/douyin-agent",
    "runtime_status": "5.9.3 field discovery passed; media acquisition blocked"
  },
  "session_commands": [
    "browse create",
    "browse approve",
    "browse record",
    "browse status",
    "browse pause",
    "browse resume",
    "inspect",
    "preview --session",
    "search --session"
