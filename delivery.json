  "requirements": [
    {
      "id": "python312",
      "kind": "rebuild",
      "handling": "setup.ps1 or setup.sh uses the shared standard-library Python installer and existing Conda to create an isolated Python 3.12 prefix from conda-win-64.lock and requirements.lock"
    },
    {
      "id": "ffmpeg",
      "kind": "host",
      "handling": "FFmpeg/FFprobe on PATH or workspace tools/ffmpeg/bin; official listed builds with checksum verification"
    },
    {
      "id": "host-capabilities",
      "kind": "host",
      "handling": "Host inventories connected Chrome/Edge, visible DOM, screenshots, search and file saving separately; first platform use has login/work tabs in one Profile"
    },
    {
      "id": "agent-plan",
      "kind": "configure",
      "handling": "VOLC_AGENT_API_KEY process env overrides workspace .env; dedicated Plan endpoints"
    },
    {
      "id": "media",
      "kind": "input",
      "handling": "User authorized media; never included in distribution"
    },
    {
      "id": "search",
      "kind": "configure",
      "handling": "Existing search plugins/skills, then host-native search, then configured Yuanbao/Bocha; local Key entry only"
    }
  ],
