{
  "schema_version": 1,
  "name": "douyin-agent",
  "default_language": "zh-CN",
  "entrypoints": {
    "repository": "../../AGENTS.md",
    "install": "../../AGENT_INSTALL.md",
    "skill": "../../SKILL.md",
    "llms": "../../llms.txt"
  },
  "path_base": "directory_containing_this_index",
  "guides": [
    {
      "id": "install",
      "title": {
        "zh-CN": "安装与升级",
        "en": "Install and upgrade"
      },
      "paths": {
