  "command_entry": "PYTHON SKILL/scripts/da.py --workspace WORKSPACE COMMAND",
  "read_only_commands": [
    "doctor",
    "status",
    "onboard --check",
    "preflight.ps1",
    "onboard --check --flow setup --observed CURRENT_JSON",
    "requests status [--cache-id ID]"
  ],
  "local_record_command": "onboard --record FILE",
  "task_flow": [
    "cleanup --expired",
    "adopt",
    "integrity",
    "preview",
    "run",
    "finalize",
    "validate"
  ],
  "host_operations": [
    "browser_connection",
    "douyin_search",
    "acquisition",
    "usage_communication",
    "original_frame_review"
  ],
  "local_context_files": [
    "workspace.json",
    "onboarding.json",
    "agent-context.json"
  ],
  "constraints": [
    "Do not expose credentials",
    "Do not infer cloud readiness from local checks",
    "Preview before paid calls",
    "Preserve unresolved request reservations",
    "Delete only proven task-owned media",
    "No universal-download guarantee"
  ],
  "helper_commands": [
    {
      "id": "unpack_images",
      "kind": "standalone_helper_not_da_subcommand",
      "script_path": "../../scripts/unpack_images.py",
      "command_entry": "PYTHON SKILL/scripts/unpack_images.py --archive ABS_ZIP --workspace ABS_WORKSPACE --output NEW_ABS_DIR --expected-images N",
      "guide_id": "acquisition",
      "conditions": [
        "Use only an acquired image ZIP and a new short ASCII workspace subdirectory",
        "Natural filename order requires host verification against the original work",
        "Preserve user-imported archives; register only proven task-owned copies"
      ]
    },
    {
      "id": "parser_transfer",
      "kind": "standalone_helper_not_da_subcommand",
      "script_path": "../../scripts/transfer.py",
      "arguments": "save --url-stdin --provider-receipt SOURCE.json --output out/file.mp4 --kind video",
      "guide_id": "runtime-transfer"
    },
    {
      "id": "download_watch",
      "kind": "standalone_helper_not_da_subcommand",
      "script_path": "../../scripts/save_watch.py",
      "arguments": "before",
      "guide_id": "runtime-runtime-host"
    },
    {
      "id": "dependency_transfer",
      "kind": "standalone_helper_not_da_subcommand",
      "script_path": "../../scripts/download-dependency.ps1",
      "arguments": "-Url OFFICIAL_URL -Output out/dependency.exe -Sha256 EXPECTED_SHA256",
      "guide_id": "runtime-transfer"
    },
    {
      "id": "browser_startup",
      "kind": "standalone_helper_not_da_subcommand",
      "script_path": "../../scripts/browser-ready.ps1",
      "arguments": "-Browser Chrome -Mode Check",
      "guide_id": "runtime-runtime-host"
    }
  ],
  "installation_entrypoints": {
    "powershell": "../../install.ps1",
    "git_bash": "../../install.sh"
  },
  "environment_entrypoints": {
    "powershell": "../../setup.ps1",
    "git_bash": "../../setup.sh"
